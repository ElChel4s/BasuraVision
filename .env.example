# BasuraVision Environment Variables Template
# Copy this file to .env and fill in the values

# Supabase URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL

# Supabase Anonymous/Publishable Key (starts with eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Supabase Service Role Key (secret server-side key to bypass RLS, starts with eyJ...)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
